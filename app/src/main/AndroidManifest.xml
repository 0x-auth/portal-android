<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Portal"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sandbox pool: each of these is a distinct component pinned to its own
             process, so each one gets a fully isolated WebView cookie/storage jar. -->
        <activity android:name=".Sandbox0Activity" android:exported="false"
            android:process=":sandbox0" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".Sandbox1Activity" android:exported="false"
            android:process=":sandbox1" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".Sandbox2Activity" android:exported="false"
            android:process=":sandbox2" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".Sandbox3Activity" android:exported="false"
            android:process=":sandbox3" android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
