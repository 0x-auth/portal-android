<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/portal_primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/sandboxToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/portal_on_surface"
            app:subtitleTextColor="@color/portal_muted"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar
        android:id="@+id/sandboxProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <WebView
        android:id="@+id/sandboxWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
