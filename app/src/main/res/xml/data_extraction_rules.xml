<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device via Google backup or device-to-device transfer:
     WebView profiles hold live session cookies/tokens. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" />
        <exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" />
        <exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
